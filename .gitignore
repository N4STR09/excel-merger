# Maven
# OJO: con 'target/' (directorio) excluido las negaciones de abajo no
# funcionan (git no desciende a un directorio excluido) y los jars habria
# que anadirlos con 'git add -f'. Con 'target/*' (hijos) si funcionan.
target/*
!target/excel-merger-4.1.0-jar-with-dependencies.jar
!target/excel-merger.jar

pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml

# Sesion de la interfaz web local (puerto/token estables; generado)
web.properties

# Sesion de la interfaz web local (ajustes de salida en runtime; generado)
web-settings.properties

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Excel temporales
~$*.xlsx

# Datos sensibles del usuario (no subir al repositorio)
# Los Excel reales de input/ y output/ pueden contener info confidencial
# (peticiones, horas imputadas, matriculas, etc.). Los fixtures de test
# en src/test/resources/fixtures/ SI se versionan: estan construidos con
# datos sinteticos y son necesarios para la red de seguridad de tests.
input/*.xlsx
input/*.xls
output/**/*.xlsx
output/**/*.xls

input/*.csv
input/*.CSV
